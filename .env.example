APP_NAME="The Khandani Legacy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# URL generation is pinned to APP_URL (see AppServiceProvider), so this has to
# be right or every generated link will be. Include the path prefix if you are
# serving the app from a subdirectory, e.g. http://localhost/familytree.
APP_URL=http://localhost
# Where the compiled Vite assets are served from. Usually the same as APP_URL.
ASSET_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=khandani_legacy
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Must be true anywhere the site is served over HTTPS, or the login cookie
# will also be sent over plain HTTP.
SESSION_SECURE_COOKIE=false

# Behind a CDN, the visitor's real address arrives in X-Forwarded-For rather
# than on the connection, and login rate limiting counts against whatever
# request()->ip() returns. Setting this to "*" (or a comma-separated list)
# makes Laravel read the forwarded address instead. Leave it empty unless the
# origin server cannot be reached except through the CDN — otherwise anyone
# can send the header themselves and walk past the throttle.
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=database

# The claim-invite email is dispatched with ->queue(). Shared hosting rarely
# runs a persistent worker, and on "database" the message would sit unsent
# forever, so "sync" is what production uses.
QUEUE_CONNECTION=database

# "log" writes mail to storage/logs instead of delivering it. Invitations and
# the "child turned 18" notice both go out by email, so this has to become
# smtp with real credentials before anyone is invited.
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=smtp.stackmail.com
MAIL_PORT=465
MAIL_USERNAME=noreply@khandanilegacy.com
MAIL_PASSWORD=
# Must match MAIL_USERNAME: StackMail rejects a From address that is not the
# authenticated mailbox, and the send fails silently when it does not.
MAIL_FROM_ADDRESS="noreply@khandanilegacy.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
